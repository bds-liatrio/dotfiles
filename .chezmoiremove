# -*-mode:bash-*- vim:ft=chezmoiremove

# ~/.local/share/chezmoi/.chezmoiremove
# =============================================================================
# If a file called .chezmoiremove exists in the source state then it is
# interpreted as a list of targets to remove. .chezmoiremove is interpreted
# as a template.
#
# Reference: https://www.chezmoi.io/docs/reference/#chezmoiremove

.gitcookies
.gitignore
.worktreeinclude

# git-toolkit external (SystemFiles/git-toolkit) removed: superseded by jj. This
# deletes the previously externally-cloned ~/.gittools directory from the target.
.gittools

# Retired targets to delete from $HOME. Previously chezmoi-managed, now gone
# from the source. Excluded on purpose: .codex/config.toml (intentionally left
# in place) and any */skills dir (ignored in .chezmoiignore; owned by
# SystemFiles/skills / the skills CLI).
.claude/CLAUDE.md
.claude/agents
.claude/commands
.claude/settings.json
.claude/statusline-simple.sh
.cursor/agents
.cursor/commands
.cursor/rules
.codex/AGENTS.md
.codex/prompts
.codex/rules
.codex/README.md
