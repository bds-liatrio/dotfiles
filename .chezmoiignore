# -*-mode:gitignore-*- vim:ft=gitignore

# ~/.local/share/chezmoi/.chezmoiignore
# =============================================================================
# If a file called .chezmoiignore exists in the source state then it is
# interpreted as a set of patterns to ignore. Patterns are matched using
# doublestar.Match and match against the target path, not the source path.
#
# Reference: https://www.chezmoi.io/docs/reference/#chezmoiignore

*.tar.gz
AGENTS.md
LICENSE.md
README.md
Makefile
*.deb
*.tar.gz
install.sh

# Repository documentation (specs, AI config notes) — never deployed to ~/
docs
docs/**

# Repo maintenance tooling — runs against the source tree, never deployed to ~/
Taskfile.yml
scripts
scripts/**

# AI skills are owned by the `skills` CLI via SystemFiles/skills (canonical at
# ~/.agents/skills, with vendor symlinks). Cede these paths so chezmoi never
# conflicts with those installs.
.agents/skills/**
.cursor/skills/**
.codex/skills/**
